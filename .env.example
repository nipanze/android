# .env.example — Copy to .env.local and fill in values.
# NEVER commit .env or .env.local — they are in .gitignore.

# -----------------------------------------------------------------------
# Supabase — Production (Stage 4)
# -----------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Service role key — ONLY used inside Edge Functions and test teardown.
# NEVER bundle in the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------
# Supabase — Local dev (auto-filled by `supabase start`)
# Update main.dart _useLocalSupabase = true to use these.
# -----------------------------------------------------------------------
LOCAL_SUPABASE_URL=http://localhost:54321
LOCAL_ANON_KEY=your-local-anon-key
LOCAL_SERVICE_ROLE_KEY=your-local-service-role-key

# -----------------------------------------------------------------------
# Stage 4 — External integrations (sandbox keys during development)
# -----------------------------------------------------------------------
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox   # sandbox | production

AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_ENV=uat           # uat | production

AFRICA_TALKING_API_KEY=
AFRICA_TALKING_USERNAME=sandbox  # sandbox | your-live-username

SMILE_IDENTITY_API_KEY=
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_ENV=sandbox     # sandbox | production
